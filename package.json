{
  "name": "desktop-cat-pet",
  "version": "1.0.0",
  "description": "A cute desktop cat pet with tamagotchi mechanics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "cat.pet.desktop",
    "productName": "Desktop Cat Pet",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "DesktopCatPet.exe"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
